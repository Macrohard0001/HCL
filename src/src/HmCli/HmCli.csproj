<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HmCli —— HmCore 无头验证工具（手机端 M1，v1.10.0 起）。

    目的：在不依赖 Windows / WPF 的纯 Linux / Termux 环境里，
    直接跑 HmCore 的核心服务（设置便携化 / 离线 UUID / 版本列举 /
    镜像清单拉取 / 平台挑选逻辑），作为 Android 移植前的真实内核验证。
    FCL / Pojav / Boat 均为「JVM 移植 + 渲染桥」路线；本 CLI 对应
    MOBILE.md 中 M1 阶段「内核先跑通」的验收工具。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HmCli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HmCore/HmCore.csproj" />
  </ItemGroup>

</Project>
