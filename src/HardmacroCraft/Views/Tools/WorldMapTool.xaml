<!-- v0.16.7：世界地图工具（独立窗口版） -->
<UserControl x:Class="HardmacroCraft.Views.Tools.WorldMapTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource S.Tool.MapTitle}" Style="{StaticResource HmSectionTitle}"
                   Margin="0,0,0,4" />
        <TextBlock Text="{DynamicResource S.Tool.MapHint}" Style="{StaticResource HmHint}"
                   Margin="0,0,0,10" TextWrapping="Wrap" />
        <WrapPanel>
            <ui:Button x:Name="BtnMapScan" MinHeight="32" MinWidth="120" Margin="0,0,8,6"
                       Content="{DynamicResource S.Tool.MapScan}" Click="BtnMapScan_Click" />
            <ComboBox x:Name="CmbMapWorlds" MinWidth="260" MinHeight="32" Margin="0,0,8,6" />
            <ui:Button x:Name="BtnMapRender" MinHeight="32" MinWidth="130" Margin="0,0,8,6"
                       Appearance="Primary"
                       Content="{DynamicResource S.Tool.MapRender}" Click="BtnMapRender_Click" />
        </WrapPanel>
        <TextBlock x:Name="TxtMapStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
