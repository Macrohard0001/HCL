<!-- v0.16.7：Rust 版 MC（Horizon）工具（独立窗口版） -->
<UserControl x:Class="HardmacroCraft.Views.Tools.HorizonTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource S.Tool.HorizonTitle}" Style="{StaticResource HmSectionTitle}"
                   Margin="0,0,0,4" />
        <TextBlock Text="{DynamicResource S.Tool.HorizonHint}" Style="{StaticResource HmHint}"
                   Margin="0,0,0,12" TextWrapping="Wrap" />
        <WrapPanel>
            <ui:Button x:Name="BtnHorizonDetect" MinHeight="32" MinWidth="110" Margin="0,0,8,6"
                       Content="{DynamicResource S.Tool.HorizonDetect}" Click="BtnHorizonDetect_Click" />
            <ui:Button x:Name="BtnHorizonDownload" MinHeight="32" MinWidth="150" Margin="0,0,8,6"
                       Appearance="Primary"
                       Content="{DynamicResource S.Tool.HorizonDownload}" Click="BtnHorizonDownload_Click" />
            <ui:Button x:Name="BtnHorizonManual" MinHeight="32" MinWidth="130" Margin="0,0,0,6"
                       Content="{DynamicResource S.Tool.HorizonManual}" Click="BtnHorizonManual_Click" />
        </WrapPanel>
        <ProgressBar x:Name="HorizonProgress" Height="4" Minimum="0" Maximum="100"
                     Margin="0,8,0,0" Visibility="Collapsed" />
        <WrapPanel>
            <ui:Button x:Name="BtnHorizonLaunch" MinHeight="32" MinWidth="130" Margin="0,0,8,0"
                       Appearance="Primary"
                       Content="{DynamicResource S.Tool.HorizonLaunch}" Click="BtnHorizonLaunch_Click" />
            <ui:Button x:Name="BtnHorizonRun" MinHeight="32" MinWidth="130" Margin="0,0,8,0"
                       Visibility="Collapsed"
                       Content="{DynamicResource S.Tool.HorizonRun}" Click="BtnHorizonRun_Click" />
        </WrapPanel>
        <TextBlock x:Name="TxtHorizonStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
