<!-- v0.16.7：截图管理（独立窗口版，扫描后打开缩略图墙） -->
<UserControl x:Class="HardmacroCraft.Views.Tools.ScreenshotsTool"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="{DynamicResource S.Tool.ShotsTitle}" Style="{StaticResource HmSectionTitle}"
                   Margin="0,0,0,4" />
        <TextBlock Text="{DynamicResource S.Tool.ShotsHint}" Style="{StaticResource HmHint}"
                   Margin="0,0,0,10" TextWrapping="Wrap" />
        <WrapPanel>
            <ui:Button x:Name="BtnShotsScan" MinHeight="32" MinWidth="120" Margin="0,0,8,6"
                       Content="{DynamicResource S.Tool.ShotsScan}" Click="BtnShotsScan_Click" />
            <ui:Button x:Name="BtnShotsView" MinHeight="32" MinWidth="130" Margin="0,0,0,6"
                       Appearance="Primary"
                       Content="{DynamicResource S.Tool.ShotsView}" Click="BtnShotsView_Click" />
        </WrapPanel>
        <TextBlock x:Name="TxtShotsStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
