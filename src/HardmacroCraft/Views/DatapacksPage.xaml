<Page x:Class="HardmacroCraft.Views.DatapacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- v0.15.0 数据包下载（PCL 同款独立页）：Modrinth datapack 分类，默认显示推荐内容；
         主容器不滚动 —— 结果列表撑满剩余空间，仅列表内滚；
         加载指示器页面居中；底部不放常驻提示（翻页条 + 短暂状态文本）。 -->
    <Grid Margin="32,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HmPageSubtitle}"
                   Text="{DynamicResource S.Dp.Subtitle}" Margin="0,0,0,10" />

        <!-- 工具条：目标版本 + 搜索 + 打开目录 -->
        <Border Grid.Row="1" Style="{StaticResource HmCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtQuery" MinHeight="30" Margin="0,0,8,0"
                            PlaceholderText="{DynamicResource S.Dp.SearchHint}"
                            KeyDown="TxtQuery_KeyDown" />
                <ComboBox x:Name="CmbVersion" Grid.Column="1" MinWidth="150" MinHeight="30" Margin="0,0,8,0"
                          ToolTip="{DynamicResource S.Sh.VersionTip}"
                          SelectionChanged="CmbVersion_SelectionChanged" />
                <ui:Button Grid.Column="2" x:Name="BtnSearch" MinHeight="30" MinWidth="88" Margin="0,0,8,0"
                           Content="{DynamicResource S.Mod.Search}" Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}" Click="BtnSearch_Click" />
                <ui:Button Grid.Column="3" MinHeight="30" MinWidth="34"
                           Icon="{ui:SymbolIcon Folder24}"
                           Content="{DynamicResource S.Sh.OpenDir}" Click="BtnOpenDir_Click"
                           ToolTip="{DynamicResource S.Sh.OpenDirTip}" />
            </Grid>
        </Border>

        <!-- 结果列表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" x:Name="LstResults" Style="{StaticResource HmListBox}"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="9"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding AuthorText}" FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Badges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="{DynamicResource S.Dp.Install}"
                                       Appearance="Primary" MinHeight="32" VerticalAlignment="Center"
                                       Click="BtnInstall_Click" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空结果提示 -->
            <StackPanel Grid.Row="0" x:Name="PnlEmpty" Visibility="Collapsed" Margin="0,40"
                        HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="SearchInfo24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="TxtEmpty" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 居中加载过渡层 -->
            <Border Grid.Row="0" Grid.RowSpan="2" x:Name="PnlSearching" Visibility="Collapsed"
                    Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.82" CornerRadius="8"
                    KeyboardNavigation.TabNavigation="None" Focusable="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing Width="42" Height="42" IsIndeterminate="True" />
                    <TextBlock x:Name="TxtSearching" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- PCL 式翻页条 + 短暂状态文本（空闲不占版面） -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel x:Name="PnlPager" Orientation="Horizontal" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtTotal" Style="{StaticResource HmHint}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Style="{StaticResource HmHint}" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxHeight="56" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
