<Page x:Class="HardmacroCraft.Views.ModpacksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Mp.Subtitle}" />
        </StackPanel>

        <!-- 工具条 -->
        <Border Grid.Row="1" Style="{StaticResource HmCard}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtQuery" Grid.Column="0" MinHeight="30" Margin="0,0,8,0"
                            PlaceholderText="{DynamicResource S.Mp.SearchHint}"
                            KeyDown="TxtQuery_KeyDown" />
                <ComboBox x:Name="CmbSort" Grid.Column="1" MinHeight="30" MinWidth="118" Margin="0,0,8,0"
                          SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource S.Mod.SortRelevance}" IsSelected="True" Tag="relevance" />
                    <ComboBoxItem Content="{DynamicResource S.Mod.SortDownloads}" Tag="downloads" />
                    <ComboBoxItem Content="{DynamicResource S.Mod.SortFollows}" Tag="follows" />
                    <ComboBoxItem Content="{DynamicResource S.Mod.SortNewest}" Tag="newest" />
                    <ComboBoxItem Content="{DynamicResource S.Mod.SortUpdated}" Tag="updated" />
                </ComboBox>
                <ui:Button Grid.Column="2" MinHeight="30" Content="{DynamicResource S.Mp.Search}"
                           Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Margin="0,0,8,0"
                           Click="BtnSearch_Click" />
                <ui:Button Grid.Column="3" MinHeight="30" Content="{DynamicResource S.Mp.LocalInstall}"
                           Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnLocalInstall_Click" />
            </Grid>
        </Border>

        <!-- 结果列表（PCL 式信息卡行） -->
        <ListBox Grid.Row="2" x:Name="LstResults" Style="{StaticResource HmListBox}"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="52" Height="52" CornerRadius="9"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding AuthorText}" FontSize="11.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                            <!-- 徽章行：分类 / 下载 / 关注 / 更新时间 / 支持版本 -->
                            <ItemsControl ItemsSource="{Binding Badges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Content="{DynamicResource S.Mp.Install}"
                                   Appearance="Primary" MinHeight="32" VerticalAlignment="Center"
                                   Click="BtnInstallPack_Click" Tag="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 进度 -->
        <!-- 加载更多（Modrinth 分页） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <ui:Button x:Name="BtnMore" Content="{DynamicResource S.Mod.LoadMore}"
                       Icon="{ui:SymbolIcon ChevronDown24}" MinHeight="30" MinWidth="160"
                       Click="BtnMore_Click" Visibility="Collapsed" />
        </StackPanel>

        <!-- v0.1.13：底部进度卡 → 容器内旋转加载指示器 + 状态文本（默认收起，有输出时展开） -->
        <Border Grid.Row="4" x:Name="CardProgress" Style="{StaticResource HmCard}" Margin="0,10,0,0"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing x:Name="RingProgress" Width="18" Height="18" IsIndeterminate="True" />
                <TextBlock x:Name="TxtProgress" Style="{StaticResource HmHint}" VerticalAlignment="Center"
                           Margin="10,0,0,0" TextWrapping="Wrap" MaxHeight="90" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
