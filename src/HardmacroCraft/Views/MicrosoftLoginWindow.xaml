<ui:FluentWindow x:Class="HardmacroCraft.Views.MicrosoftLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource S.Login.Title}"
                 Width="540" Height="480"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- fix5：ExtendsContentIntoTitleBar=true 时必须自建 TitleBar 才有关闭按钮 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource S.Login.Title}"
                     Padding="10,8,0,0" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="32,12,32,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                <ui:SymbolIcon Symbol="Person24" FontSize="20" Foreground="White" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S.Login.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource S.Login.Step1}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 验证码展示区（PCL 风格：大号验证码 + 复制 + 打开网页） -->
        <Border Style="{StaticResource HmCard}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtUserCode" Text="——————" FontSize="30" FontWeight="Bold"
                           FontFamily="Consolas" VerticalAlignment="Center"
                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <ui:Button Grid.Column="1" x:Name="BtnCopy" Content="{DynamicResource S.Login.Copy}"
                           Icon="{ui:SymbolIcon Copy24}" MinHeight="36" Margin="8,0,4,0" Click="BtnCopy_Click" />
                <ui:Button Grid.Column="2" x:Name="BtnOpen" Appearance="Primary" MinHeight="36"
                           Content="{DynamicResource S.Login.OpenBrowser}"
                           Icon="{ui:SymbolIcon Open24}" Click="BtnOpen_Click" />
            </Grid>
        </Border>

        <TextBlock Text="{DynamicResource S.Login.Step2}" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10" />
        <ProgressBar x:Name="PbLogin" IsIndeterminate="True" Height="6" Margin="0,0,0,10" />
        <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="13"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

        <ui:Button x:Name="BtnCancel" Content="{DynamicResource S.Login.Cancel}"
                   HorizontalAlignment="Left" MinHeight="36" Click="BtnCancel_Click" />
    </StackPanel>
    </Grid>
</ui:FluentWindow>
