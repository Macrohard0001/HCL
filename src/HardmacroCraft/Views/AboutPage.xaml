<Page x:Class="HardmacroCraft.Views.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer Style="{StaticResource HmScrollViewer}">
        <StackPanel Margin="32,24,32,24" MaxWidth="880" HorizontalAlignment="Stretch">

            <!-- 头部：图标 + 名称 + 版本徽章 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Width="64" Height="64" CornerRadius="14"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                    <Image Source="/Assets/icon.png" Width="52" Height="52" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hardmacro Craft Launcher" FontSize="28" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border CornerRadius="5" Padding="8,2"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                            <TextBlock x:Name="TxtVersion" Text="{DynamicResource S.About.Version}" FontSize="12" Foreground="White" />
                        </Border>
                        <Border CornerRadius="5" Padding="8,2" Margin="8,0,0,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{DynamicResource S.About.Tagline}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <Border CornerRadius="5" Padding="8,2" Margin="8,0,0,0"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock Text="{DynamicResource S.About.Developer}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource HmCard}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.About.What}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.About.WhatBody}" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.About.License}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.About.LicenseBody}" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.About.Thanks}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.About.ThanksBody}" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.About.Disclaimer}" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.About.DisclaimerBody}" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
