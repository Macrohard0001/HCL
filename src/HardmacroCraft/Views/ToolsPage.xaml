<!--
    v0.16.7：工具页重构 —— 主窗口只保留入口网格，全部工具在独立窗口打开
    （ToolHostWindow + Views/Tools/*），不影响主窗口，可多开并排。
    入口卡片：图标 + 标题 + 一句说明，整卡可点。
-->
<Page x:Class="HardmacroCraft.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource HmScrollViewer}">
        <StackPanel Margin="24,12,24,16" MaxWidth="820">

            <TextBlock Text="{DynamicResource S.Tool.Title}" Style="{StaticResource HmPageTitle}" />
            <TextBlock Text="{DynamicResource S.Tool.Hint}" Style="{StaticResource HmHint}"
                       Margin="0,4,0,18" />

            <UniformGrid Columns="2">
                <Border x:Name="EntrySeed" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenSeed_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Map24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.SlimeTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.SlimeHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryWorldMap" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenWorldMap_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Globe20" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.MapTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.MapHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntrySpeedrun" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenSpeedrun_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Timer24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.SpeedTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.SpeedHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryServer" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenServer_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Server24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.SrvTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.SrvHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryShots" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenShots_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Camera24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.ShotsTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.ShotsHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryBackup" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenBackup_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Shield20" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.BackupTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.BackupHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryMigration" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenMigration_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="ArrowTransfer24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.MigTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.MigHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryHorizon" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenHorizon_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Play24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.HorizonTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.HorizonHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryBedrock" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenBedrock_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Apps24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.BedrockTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.BedrockHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryDoctor" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenDoctor_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="HeartPulse20" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.DoctorTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.DoctorHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryWorlds" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenWorlds_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Save24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.WorldsTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.WorldsHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryLog" Style="{StaticResource HmCard}" Margin="8,0,0,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenLog_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="ClipboardTextEdit24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.LogTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.LogHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryTrash" Style="{StaticResource HmCard}" Margin="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OpenTrash_Click">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource S.Tool.TrashTitle}" Style="{StaticResource HmSectionTitle}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource S.Tool.TrashHint}" Style="{StaticResource HmHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
