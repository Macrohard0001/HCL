<!--
    v0.15.10：种子工具页（第一步：史莱姆挂机点查询）。
    输入世界种子 → 按原版算法整片预览史莱姆区块（WriteableBitmap 网格），
    统计占比并推荐 3×3 / 2×2 全绿连片中心作挂机塔位置。
    纯本地计算，无需读取世界文件。样式复用全局 HmPageTitle / HmCard / HmHint。
-->
<Page x:Class="HardmacroCraft.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource HmScrollViewer}">
        <StackPanel Margin="24,12,24,16" MaxWidth="760">

            <TextBlock Text="{DynamicResource S.Tool.Title}" Style="{StaticResource HmPageTitle}" />
            <TextBlock Text="{DynamicResource S.Tool.Hint}" Style="{StaticResource HmHint}"
                       Margin="0,4,0,18" />

            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Tool.SlimeTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{DynamicResource S.Tool.SlimeHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtSeed" Grid.Column="0" Height="34"
                                    PlaceholderText="{DynamicResource S.Tool.SeedPlaceholder}" />
                        <ui:TextBox x:Name="TxtRange" Grid.Column="2" Height="34"
                                    PlaceholderText="{DynamicResource S.Tool.RangePlaceholder}" />
                        <ui:Button x:Name="BtnGenerate" Grid.Column="4" Appearance="Primary" Height="34"
                                   Padding="18,0" Content="{DynamicResource S.Tool.Generate}"
                                   Click="BtnGenerate_Click" />
                    </Grid>
                    <TextBlock x:Name="TxtStatus" Style="{StaticResource HmHint}" Margin="0,10,0,0"
                               TextWrapping="Wrap" />
                    <Image x:Name="MapImage" MaxWidth="520" MaxHeight="520" Margin="0,12,0,0"
                           HorizontalAlignment="Left" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- ===== v0.16.1：Horizon 下载入口（去广告化） =====
                 出处：github.com/horizon-rust/horizon（LGPL-3.0）。
                 加载即爬取 GitHub 最新 release 显示版本/体积，一键应用内下载或浏览器手动下载。 -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Tool.HorizonTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource S.Tool.HorizonHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button x:Name="BtnHorizonDetect" MinHeight="32" MinWidth="110" Margin="0,0,8,6"
                                   Content="{DynamicResource S.Tool.HorizonDetect}" Click="BtnHorizonDetect_Click" />
                        <ui:Button x:Name="BtnHorizonDownload" MinHeight="32" MinWidth="150" Margin="0,0,8,6"
                                   Appearance="Primary"
                                   Content="{DynamicResource S.Tool.HorizonDownload}" Click="BtnHorizonDownload_Click" />
                        <ui:Button x:Name="BtnHorizonManual" MinHeight="32" MinWidth="130" Margin="0,0,0,6"
                                   Content="{DynamicResource S.Tool.HorizonManual}" Click="BtnHorizonManual_Click" />
                    </WrapPanel>
                    <ProgressBar x:Name="HorizonProgress" Height="4" Minimum="0" Maximum="100"
                                 Margin="0,8,0,0" Visibility="Collapsed" />
                    <WrapPanel>
                        <ui:Button x:Name="BtnHorizonLaunch" MinHeight="32" MinWidth="130" Margin="0,0,8,0"
                                   Appearance="Primary"
                                   Content="{DynamicResource S.Tool.HorizonLaunch}" Click="BtnHorizonLaunch_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="TxtHorizonStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== v0.16.2：基岩版（Bedrock）—— 正版路径：Store 版检测/启动 + 官方 BDS 服务端下载 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Tool.BedrockTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource S.Tool.BedrockHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,12" TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button x:Name="BtnBedrockDetect" MinHeight="32" MinWidth="110" Margin="0,0,8,6"
                                   Content="{DynamicResource S.Tool.BedrockDetect}" Click="BtnBedrockDetect_Click" />
                        <ui:Button x:Name="BtnBedrockLaunch" MinHeight="32" MinWidth="110" Margin="0,0,8,6"
                                   Appearance="Primary"
                                   Content="{DynamicResource S.Tool.BedrockLaunch}" Click="BtnBedrockLaunch_Click" />
                        <ui:Button x:Name="BtnBedrockBds" MinHeight="32" MinWidth="150" Margin="0,0,8,6"
                                   Content="{DynamicResource S.Tool.BedrockBds}" Click="BtnBedrockBds_Click" />
                        <ui:Button x:Name="BtnBedrockStore" MinHeight="32" MinWidth="130" Margin="0,0,0,6"
                                   Content="{DynamicResource S.Tool.BedrockStore}" Click="BtnBedrockStore_Click" />
                    </WrapPanel>
                    <!-- v0.16.3：minecraft:// 深链一键注册外部服务器并启动（官方协议，LeviLauncher 同款思路） -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:TextBox x:Name="TxtJoinName" MinWidth="130" MinHeight="32"
                                    PlaceholderText="{DynamicResource S.Tool.JoinNamePh}" />
                        <ui:TextBox x:Name="TxtJoinAddr" MinWidth="190" MinHeight="32" Margin="8,0,0,0"
                                    PlaceholderText="{DynamicResource S.Tool.JoinAddrPh}" />
                        <ui:Button x:Name="BtnBedrockJoin" MinHeight="32" MinWidth="130" Margin="8,0,0,0"
                                   Content="{DynamicResource S.Tool.BedrockJoin}" Click="BtnBedrockJoin_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="BedrockProgress" Height="4" Minimum="0" Maximum="100"
                                 Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtBedrockStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />

                    <!-- v0.16.3：LeviLauncher 集成（LiteLDev 开源 GPL-3.0；README 要求正版授权副本，授权模型一致） -->
                    <TextBlock Text="{DynamicResource S.Tool.LeviTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,14,0,4" />
                    <TextBlock Text="{DynamicResource S.Tool.LeviHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnLeviDownload" MinHeight="32" MinWidth="150" Margin="0,0,8,0"
                                   Content="{DynamicResource S.Tool.LeviDownload}" Click="BtnLeviDownload_Click" />
                        <ui:Button x:Name="BtnLeviDocs" MinHeight="32" MinWidth="110"
                                   Content="{DynamicResource S.Tool.LeviDocs}" Click="BtnLeviDocs_Click" />
                    </StackPanel>

            <!-- ===== v0.16.4：从其他启动器导入（扫描内置位置 → 选择候选 → 隔离语义导入） ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Tool.MigTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource S.Tool.MigHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,10" TextWrapping="Wrap" />
                    <WrapPanel>
                        <ui:Button x:Name="BtnMigScan" MinHeight="32" MinWidth="130" Margin="0,0,8,6"
                                   Content="{DynamicResource S.Tool.MigScan}" Click="BtnMigScan_Click" />
                        <ComboBox x:Name="CmbMigCandidates" MinWidth="260" MinHeight="32" Margin="0,0,8,6" />
                        <ui:Button x:Name="BtnMigImport" MinHeight="32" MinWidth="130" Margin="0,0,8,6"
                                   Appearance="Primary"
                                   Content="{DynamicResource S.Tool.MigImport}" Click="BtnMigImport_Click" />
                        <CheckBox x:Name="ChkMigIsolation" VerticalAlignment="Center" Margin="0,0,0,6"
                                  Content="{DynamicResource S.Tool.MigIsolation}" />
                    </WrapPanel>
                    <TextBlock x:Name="TxtMigStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== v0.16.4：一键诊断报告（doctor） ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource S.Tool.DoctorTitle}" Style="{StaticResource HmSectionTitle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource S.Tool.DoctorHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnDoctor" MinHeight="32" MinWidth="130"
                                   Content="{DynamicResource S.Tool.DoctorGo}" Click="BtnDoctor_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtDoctorStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>