<ui:FluentWindow x:Class="HardmacroCraft.Views.LoaderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Width="520" Height="620"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- fix5：ExtendsContentIntoTitleBar=true 时必须自建 TitleBar 才有关闭按钮 -->
        <ui:TitleBar Grid.Row="0" Padding="10,8,0,0" />
    <Grid Grid.Row="1" Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="5" Height="22" CornerRadius="2.5"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                    VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock x:Name="TxtTitle" FontSize="19" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </StackPanel>
        <TextBlock Grid.Row="0" Margin="15,30,0,14" Style="{StaticResource HmHint}"
                   Text="{DynamicResource S.Dl.LoaderHint}" VerticalAlignment="Bottom" />

        <!-- 加载器列表 -->
        <ListBox x:Name="LstLoaders" Grid.Row="1" Style="{StaticResource HmListBox}"
                 BorderThickness="0" Background="Transparent"
                 SelectionMode="Single" SelectionChanged="LstLoaders_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="8" Grid.Column="0"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <Image Source="{Binding Icon}" Width="24" Height="24"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14.5"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Background="#3327C93F" BorderBrush="#27C93F" BorderThickness="1"
                                        Visibility="{Binding RecommendedVisibility}">
                                    <TextBlock Text="{DynamicResource S.Dl.LoaderRecommended}" FontSize="10.5"
                                               Foreground="#2FD155" />
                                </Border>
                                <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                        BorderThickness="1" Visibility="{Binding LegacyVisibility}">
                                    <TextBlock Text="{DynamicResource S.Dl.LoaderLegacy}" FontSize="10.5"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Desc}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 加载器版本行（v0.1.14：下拉带滚动条 + 兼容说明实时刷新） -->
        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource S.Dl.LoaderVersion}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
                <ComboBox x:Name="CmbLoaderVersion" MinWidth="220" MinHeight="30" Margin="10,0,0,0"
                          MaxDropDownHeight="280" />
            </StackPanel>
            <TextBlock x:Name="TxtLoaderCompat" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>

        <!-- 自定义版本名称（fix5，PCL 同款：可选改名后安装） -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{DynamicResource S.Dl.VersionNameLabel}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" />
            <ui:TextBox x:Name="TxtVersionName" MinWidth="220" MinHeight="30" Margin="10,0,0,0"
                        PlaceholderText="{DynamicResource S.Dl.VersionNameHint}" />
        </StackPanel>

        <!-- 进度 + 按钮 -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <ProgressBar x:Name="PbInstall" Height="6" Maximum="100" Visibility="Collapsed" />
            <TextBlock x:Name="TxtStatus" Style="{StaticResource HmHint}" Margin="0,6,0,0"
                       TextWrapping="Wrap" MaxHeight="60" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <ui:Button x:Name="BtnInstall" MinHeight="32" MinWidth="120" Appearance="Primary"
                           Content="{DynamicResource S.Dl.Install}" Icon="{ui:SymbolIcon ArrowDownload24}"
                           Margin="0,0,8,0" Click="BtnInstall_Click" />
                <ui:Button x:Name="BtnBackground" MinHeight="32" Margin="0,0,8,0" Visibility="Collapsed"
                           Content="{DynamicResource S.Dl.BtnBackground}" Icon="{ui:SymbolIcon ArrowMinimize24}"
                           Click="BtnBackground_Click" ToolTip="{DynamicResource S.Dl.BtnBackgroundTip}" />
                <ui:Button x:Name="BtnCancel" MinHeight="32" Margin="0,0,8,0" Visibility="Collapsed"
                           Content="{DynamicResource S.Common.Cancel}" Click="BtnCancel_Click" />
                <ui:Button x:Name="BtnClose" MinHeight="32" Content="{DynamicResource S.Common.Close}"
                           Click="BtnClose_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
