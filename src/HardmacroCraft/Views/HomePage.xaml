<Page x:Class="HardmacroCraft.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer Style="{StaticResource HmScrollViewer}">
        <StackPanel Margin="32,24,32,24" MaxWidth="920" HorizontalAlignment="Stretch">

            <!-- 标题（PCL 式强调条） -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <Border Width="5" Height="24" CornerRadius="2.5"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource HmPageTitle}" Text="{DynamicResource S.Home.Title}" />
            </StackPanel>
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Home.Subtitle}" />

            <!-- 启动大卡（PCL 式：账号行 + 版本选择 + 大启动按钮） -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <!-- 账号行（原独立账号卡合并进启动卡，头像即入口） -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 头像（皮肤头部贴图，无皮肤时回退首字母圆形） -->
                        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="23"
                                Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                                Cursor="Hand" MouseLeftButtonUp="AccountCard_Click"
                                ToolTip="{DynamicResource S.Acct.Title}">
                            <Grid>
                                <Image x:Name="ImgAvatar" Width="46" Height="46" Stretch="Fill"
                                       Visibility="Collapsed" />
                                <TextBlock x:Name="TxtAvatar" Text="?" FontSize="20" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,8,0"
                                    Cursor="Hand" MouseLeftButtonUp="AccountCard_Click">
                            <TextBlock x:Name="TxtAccount" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="..." />
                            <TextBlock x:Name="TxtAccountType" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="2" x:Name="BtnManageAccounts"
                                   Content="{DynamicResource S.Acct.Manage}"
                                   Icon="{ui:SymbolIcon PeopleTeam24}"
                                   Margin="0,0,8,0" MinHeight="36" Click="BtnManageAccounts_Click" />
                        <ui:Button Grid.Column="3" x:Name="BtnMsLogin"
                                   Content="{DynamicResource S.Home.MsLogin}"
                                   Appearance="Primary" Icon="{ui:SymbolIcon Person24}"
                                   Margin="0,0,8,0" MinHeight="36" Click="BtnMicrosoftLogin_Click" />
                        <ui:Button Grid.Column="4" x:Name="BtnAuthlibLogin"
                                   Content="{DynamicResource S.Home.ThirdLogin}"
                                   Icon="{ui:SymbolIcon Globe24}"
                                   Margin="0,0,8,0" MinHeight="36" Click="BtnAuthlibLogin_Click" />
                        <ui:Button Grid.Column="5" x:Name="BtnOfflineLogin"
                                   Content="{DynamicResource S.Home.OfflineLogin}"
                                   Icon="{ui:SymbolIcon PersonCircle24}"
                                   MinHeight="36" Click="BtnOfflineLogin_Click" />
                    </Grid>

                    <Separator Margin="0,0,0,14" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                    <!-- 版本选择（PCL 式：图标标题 + 刷新） -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Games24" FontSize="18"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.SelectVersion}" FontWeight="Medium"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" x:Name="BtnRefreshVersions" MinHeight="34"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnRefreshVersions_Click" />
                    </Grid>

                    <ComboBox x:Name="CmbVersions" MinHeight="42" FontSize="15" Margin="0,0,0,12" />

                    <!-- fix6：快速进服（PCL 同款）——填写服务器地址，启动后直接进服 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <ui:SymbolIcon Symbol="Globe24" FontSize="15"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.QuickServer}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" x:Name="TxtQuickServer" MinHeight="38"
                                    PlaceholderText="{DynamicResource S.Home.QuickServerPh}" />
                        <ui:Button Grid.Column="2" Content="{DynamicResource S.Home.QuickServerBtn}"
                                   MinHeight="38" Margin="8,0,0,0" Icon="{ui:SymbolIcon PlugConnected24}"
                                   Click="BtnQuickServer_Click" />
                    </Grid>

                    <ui:Button x:Name="BtnLaunch" Appearance="Primary" Content="{DynamicResource S.Home.Launch}"
                               Icon="{ui:SymbolIcon Play24}" MinHeight="52" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Stretch" Click="BtnLaunch_Click" />

                    <ProgressBar x:Name="PbProgress" Height="6" Margin="0,14,0,4" Maximum="100" IsIndeterminate="False" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="TxtProgress" FontSize="12" MaxHeight="34" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <!-- fix7：第二行显示当前阶段【第几步/共几步】 -->
                            <TextBlock x:Name="TxtStage" FontSize="12" FontWeight="Medium" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- fix7：启动/下载中可取消（PCL/HMCL 同款） -->
                        <ui:Button x:Name="BtnCancelLaunch" Grid.Column="1" Content="{DynamicResource S.Common.Cancel}"
                                   Icon="{ui:SymbolIcon Dismiss24}" MinHeight="34" VerticalAlignment="Top"
                                   Visibility="Collapsed" Click="BtnCancelLaunch_Click"
                                   ToolTip="{DynamicResource S.Home.CancelLaunchTip}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 快捷入口（PCL 首页同款：下载 / 整合包 / 模组） -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HmCard}" Padding="14,12" Cursor="Hand"
                        MouseLeftButtonUp="BtnQuickDownload_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Nav.DownloadGame}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{DynamicResource S.Home.Quick.DownloadTip}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource HmCard}" Padding="14,12" Cursor="Hand"
                        MouseLeftButtonUp="BtnQuickModpacks_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BoxMultiple24" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Nav.Modpacks}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{DynamicResource S.Home.Quick.ModpacksTip}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource HmCard}" Padding="14,12" Cursor="Hand"
                        MouseLeftButtonUp="BtnQuickMods_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="22"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource S.Nav.Mods}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{DynamicResource S.Home.Quick.ModsTip}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近启动（PCL/HMCL 主页同款快捷启动） -->
            <Border x:Name="CardRecent" Style="{StaticResource HmCard}" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ui:SymbolIcon Symbol="History24" FontSize="18"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource S.Home.Recent}" FontWeight="Medium"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel x:Name="PnlRecent" />
                </StackPanel>
            </Border>

            <!-- 日志（终端风格，默认收起：PCL 同款不占首页空间，点标题展开） -->
            <Border Style="{StaticResource HmCard}" Padding="14" Margin="0,14,0,0">
                <StackPanel>
                    <Grid Cursor="Hand" MouseLeftButtonUp="BtnToggleLog_Click" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Code24" FontSize="14"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{DynamicResource S.Home.Log}" FontSize="12" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:SymbolIcon x:Name="IcoLogToggle" Symbol="ChevronDown24" FontSize="14"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <Border x:Name="PnlLogBox" CornerRadius="8" Background="#F215181C"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Visibility="Collapsed">
                        <Grid MinHeight="200">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8,12,4">
                                <ui:Button x:Name="BtnOpenLogs" Content="{DynamicResource S.Home.OpenLogs}"
                                           FontSize="11" MinHeight="26" Padding="8,2" Margin="0,0,8,0"
                                           Background="Transparent" BorderBrush="#33FFFFFF" Foreground="#CCFFFFFF"
                                           Icon="{ui:SymbolIcon Folder24}" Click="BtnOpenLogs_Click" />
                                <ui:Button x:Name="BtnOpenCrash" Content="{DynamicResource S.Home.OpenCrash}"
                                           FontSize="11" MinHeight="26" Padding="8,2"
                                           Background="Transparent" BorderBrush="#33FFFFFF" Foreground="#CCFFFFFF"
                                           Icon="{ui:SymbolIcon Bug24}" Click="BtnOpenCrash_Click" />
                            </StackPanel>
                            <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas"
                                     FontSize="12" Foreground="#FFE2E6EC" Background="Transparent"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Margin="10,0,10,8"
                                     TextChanged="TxtLog_TextChanged" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
