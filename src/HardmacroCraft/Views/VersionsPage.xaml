<Page x:Class="HardmacroCraft.Views.VersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Ver.Subtitle}" />
        </StackPanel>

        <!-- v0.1.6 搜索（同类启动器式：版本多了以后快速定位）；右侧显示版本总数 -->
        <Grid Grid.Row="1" Margin="0,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="TxtSearch" MinHeight="30"
                        PlaceholderText="{DynamicResource S.Ver.SearchPh}"
                        Icon="{ui:SymbolIcon Search24}"
                        TextChanged="TxtSearch_TextChanged" />
            <TextBlock Grid.Column="1" x:Name="TxtVerCount" Margin="12,0,2,0" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>

        <!-- 工具按钮（WrapPanel：小窗口下自动换行） -->
        <Border Grid.Row="2" Style="{StaticResource HmCard}" Margin="0,0,0,12" Padding="12">
            <WrapPanel>
                <ui:Button Content="{DynamicResource S.Ver.Launch}" MinHeight="32" Margin="0,0,8,8"
                           Appearance="Primary" Icon="{ui:SymbolIcon Play24}" Click="BtnLaunch_Click" />
                <ui:Button Content="{DynamicResource S.Ver.Settings}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Settings24}" Click="BtnSettings_Click" />
                <ui:Button Content="{DynamicResource S.Ver.Refresh}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Click="BtnRefresh_Click" />
                <ui:Button Content="{DynamicResource S.Ver.OpenFolder}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Folder24}" Click="BtnOpenFolder_Click" />
                <ui:Button Content="{DynamicResource S.Ver.OpenSaves}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Save24}" Click="BtnOpenSaves_Click" />
                <ui:Button Content="{DynamicResource S.Ver.OpenMods}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon PuzzlePiece24}" Click="BtnOpenMods_Click" />
                <ui:Button Content="{DynamicResource S.Ver.OpenPacks}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Image24}" Click="BtnOpenPacks_Click" />
                <ui:Button Content="{DynamicResource S.Ver.Rename}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Edit24}" Click="BtnRename_Click" />
                <ui:Button Content="{DynamicResource S.Ver.Copy}" MinHeight="32" Margin="0,0,8,8"
                           Icon="{ui:SymbolIcon Copy24}" Click="BtnCopy_Click" />
                <ui:Button Content="{DynamicResource S.Ver.Delete}" MinHeight="32" Margin="0,0,0,8"
                           Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" Click="BtnDelete_Click" />
            </WrapPanel>
        </Border>

        <!-- v0.1.6 版本列表（PCL 式）：图标（加载器 / 创建来源）+ 名称 + 副标题；单击进版本设置 -->
        <ListBox Grid.Row="3" x:Name="LstVersions" Style="{StaticResource HmListBox}"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectionMode="Single"
                 MouseDoubleClick="LstVersions_MouseDoubleClick"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="12,9">
                        <Border Width="40" Height="40" CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="30" Height="30"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                       Visibility="{Binding IconVis}" />
                                <Border CornerRadius="7" Width="30" Height="30"
                                        Background="{Binding BadgeBrush}"
                                        Visibility="{Binding BadgeVis}">
                                    <TextBlock Text="{Binding Badge}" Foreground="White"
                                               FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 提示行 -->
        <TextBlock Grid.Row="4" Text="{DynamicResource S.Ver.ClickHint}" FontSize="11"
                   Margin="2,8,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
</Page>
