<Page x:Class="HardmacroCraft.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- v0.1.7：主容器不滚动 —— 标题固定，设置内容在内部区域滚动（对齐系统设置式页面）
         v0.1.11：设置项全面分组整理（外观 / 游戏目录 / 游戏内存 / Java / 启动 / 网络 / 启动器维护），
         新增「界面刷新频率」与「相对路径增强」。 -->
    <Grid Margin="32,24,32,24" MaxWidth="880" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Set.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource HmScrollViewer}">
            <StackPanel>

            <!-- ===== 1. 外观 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.Appearance}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.ThemeHint}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource S.Set.Theme}" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox x:Name="CmbTheme" MinHeight="30" MinWidth="200"
                                  SelectionChanged="CmbTheme_SelectionChanged">
                            <ComboBoxItem Content="{DynamicResource S.Set.ThemeDark}" Tag="dark" />
                            <ComboBoxItem Content="{DynamicResource S.Set.ThemeLight}" Tag="light" />
                            <ComboBoxItem Content="{DynamicResource S.Set.ThemeSystem}" Tag="system" />
                        </ComboBox>
                        <TextBlock Text="{DynamicResource S.Set.Language}" FontWeight="Medium"
                                   VerticalAlignment="Center" Margin="24,0,12,0" />
                        <ComboBox x:Name="CmbLanguage" MinHeight="30" MinWidth="140">
                            <ComboBoxItem Content="简体中文" Tag="zh-CN" IsSelected="True" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </StackPanel>

                    <!-- v0.1.11：界面刷新频率（自动 / 手动 FPS / 事件驱动 / 事件驱动限频） -->
                    <TextBlock Text="{DynamicResource S.Set.UiRefresh}" FontWeight="Medium" Margin="0,16,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.UiRefreshHint}" Style="{StaticResource HmHint}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbUiRefresh" MinHeight="30" MinWidth="230" SelectionChanged="CmbUiRefresh_Changed">
                            <ComboBoxItem Content="{DynamicResource S.Set.UiRefreshAuto}" Tag="auto" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource S.Set.UiRefreshManual}" Tag="manual" />
                            <ComboBoxItem Content="{DynamicResource S.Set.UiRefreshEvent}" Tag="event" />
                            <ComboBoxItem Content="{DynamicResource S.Set.UiRefreshEventLimited}" Tag="event-limited" />
                        </ComboBox>
                        <StackPanel x:Name="PnlUiRefreshFps" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource S.Set.UiRefreshFps}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:NumberBox x:Name="NumUiFps" MinWidth="96" MinHeight="32" Minimum="1" Maximum="240"
                                          Value="30" SmallChange="1" LargeChange="10" />
                        </StackPanel>
                        <StackPanel x:Name="PnlUiRefreshMaxFps" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource S.Set.UiRefreshMaxFps}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:NumberBox x:Name="NumUiMaxFps" MinWidth="96" MinHeight="32" Minimum="1" Maximum="240"
                                          Value="30" SmallChange="1" LargeChange="10" />
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== 2. 游戏目录 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.GameRoot}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.GameRootHint}" />
                        </StackPanel>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtGameRoot" MinHeight="30" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" MinHeight="30" Content="{DynamicResource S.Set.Browse}"
                                   Click="BtnBrowseRoot_Click" />
                    </Grid>

                    <!-- v0.1.11：相对路径增强（移动磁盘 / 整目录迁移友好） -->
                    <CheckBox x:Name="ChkRelativePaths" Content="{DynamicResource S.Set.RelativePaths}" Margin="0,14,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.RelativePathsHint}" Style="{StaticResource HmHint}"
                               Margin="24,0,0,10" TextWrapping="Wrap" />

                    <CheckBox x:Name="ChkIsolation" Content="{DynamicResource S.Set.Isolation}" Margin="0,4,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.IsolationHint}" Style="{StaticResource HmHint}" Margin="24,0,0,2"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 3. 游戏内存 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.Memory}" />
                                <TextBlock x:Name="TxtMemValue" Style="{StaticResource HmSectionTitle}" Margin="8,0,0,0"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.JavaHint}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkMemAuto" Content="{DynamicResource S.Set.MemAuto}" Margin="0,0,0,2"
                              Checked="ChkMemAuto_Changed" Unchecked="ChkMemAuto_Changed" />
                    <TextBlock Text="{DynamicResource S.Set.MemAutoHint}" Style="{StaticResource HmHint}" Margin="24,0,0,8"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtMemDetected" Style="{StaticResource HmHint}" Margin="0,0,0,10"
                               TextWrapping="Wrap" Foreground="{DynamicResource SystemAccentColorSecondaryBrush}" />

                    <Slider x:Name="SldMemory" Minimum="1024" Maximum="32768" TickFrequency="512"
                            IsSnapToTickEnabled="True" Margin="0,0,0,8" ValueChanged="SldMemory_ValueChanged" />
                </StackPanel>
            </Border>

            <!-- ===== 4. 启动器维护（内存优化 / 手动清理 / 日志滚动） ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.LauncherMemGroup}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.LauncherMemGroupHint}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkLauncherMemOpt" Content="{DynamicResource S.Set.LauncherMemOpt}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.LauncherMemOptHint}" Style="{StaticResource HmHint}" Margin="24,0,0,6"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnMemClean" Content="{DynamicResource S.Set.MemCleanNow}"
                                   Icon="{ui:SymbolIcon Broom24}" MinHeight="30" MinWidth="110"
                                   Click="BtnMemClean_Click" />
                        <TextBlock x:Name="TxtLauncherMem" Style="{StaticResource HmHint}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- v0.1.11：日志平滑滚动开关（任务详情 / 设置页等日志区域共用） -->
                    <CheckBox x:Name="ChkSmoothScroll" Content="{DynamicResource S.Set.SmoothScroll}" Margin="0,14,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.SmoothScrollHint}" Style="{StaticResource HmHint}"
                               Margin="24,0,0,0" TextWrapping="Wrap" />

                    <!-- v0.1.12：一键配置 Mods —— 开始移除前先备份（PCL 式兜底） -->
                    <CheckBox x:Name="ChkModSetupBackup" Content="{DynamicResource S.Set.ModSetupBackup}" Margin="0,14,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.ModSetupBackupHint}" Style="{StaticResource HmHint}"
                               Margin="24,0,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 5. Java ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.JavaManage}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.JavaManageHint}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkAutoJava" Content="{DynamicResource S.Set.AutoJava}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.AutoJavaHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12" />

                    <TextBlock Text="{DynamicResource S.Set.Java}" FontWeight="Medium" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtJava" MinHeight="30" Margin="0,0,8,0"
                                    PlaceholderText="C:\\path\\to\\javaw.exe 或其所在文件夹（fix5 支持文件夹自动搜索）" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button MinHeight="30" Content="exe" MinWidth="54" Margin="0,0,6,0"
                                       ToolTip="选择 javaw.exe / java.exe 文件" Click="BtnBrowseJava_Click" />
                            <ui:Button MinHeight="30" Content="{DynamicResource S.Set.BrowseFolder}" MinWidth="54"
                                       ToolTip="选择 Java 所在文件夹（自动搜索 javaw.exe）" Click="BtnBrowseJavaFolder_Click" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.JavaPathHint}" Margin="0,6,0,12" />

                    <!-- fix5：Java 下载位置自定义 -->
                    <TextBlock Text="{DynamicResource S.Set.JavaDir}" FontWeight="Medium" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtJavaDir" MinHeight="30" Margin="0,0,8,0"
                                    PlaceholderText="{DynamicResource S.Set.JavaDirHint}" />
                        <ui:Button Grid.Column="1" MinHeight="30" Content="{DynamicResource S.Set.BrowseFolder}"
                                   Click="BtnBrowseJavaDir_Click" />
                    </Grid>
                    <TextBlock Text="{DynamicResource S.Set.JavaDirHint2}" Style="{StaticResource HmHint}" Margin="0,6,0,12" />

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource S.Set.JavaDownload}" VerticalAlignment="Center"
                                   FontWeight="Medium" Margin="0,0,12,0" />
                        <ComboBox x:Name="CmbJavaMajor" MinHeight="30" MinWidth="130">
                            <ComboBoxItem Content="Java 8" Tag="8" />
                            <ComboBoxItem Content="Java 17" Tag="17" />
                            <ComboBoxItem Content="Java 21" Tag="21" IsSelected="True" />
                            <ComboBoxItem Content="Java 25" Tag="25" />
                        </ComboBox>
                        <ui:Button x:Name="BtnDownloadJava" Content="{DynamicResource S.Set.JavaDownloadBtn}"
                                   Icon="{ui:SymbolIcon ArrowDownload24}" MinHeight="30" Margin="8,0,0,0"
                                   Click="BtnDownloadJava_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="PbJava" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TxtJavaStatus" Style="{StaticResource HmHint}" Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtJavaManaged" Style="{StaticResource HmHint}" Margin="0,6,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 6. 启动 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.LaunchGroup}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.LaunchGroupHint}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- JVM 优化 / JVM 参数 / 游戏参数 -->
                    <CheckBox x:Name="ChkJvmOptimize" Content="{DynamicResource S.Set.JvmOptimize}" Margin="0,0,0,2"
                              IsChecked="True" />
                    <TextBlock Text="{DynamicResource S.Set.JvmOptimizeHint}" Style="{StaticResource HmHint}" Margin="24,0,0,10"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource S.Set.JvmArgs}" FontWeight="Medium" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.JvmArgsHint}" Style="{StaticResource HmHint}" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="TxtJvmArgs" MinHeight="30" FontFamily="Consolas"
                                PlaceholderText="-XX:+UseG1GC -Dfile.encoding=UTF-8" />

                    <TextBlock Text="{DynamicResource S.Set.GameArgs}" FontWeight="Medium" Margin="0,16,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.GameArgsHint}" Style="{StaticResource HmHint}" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="TxtGameArgs" MinHeight="30" FontFamily="Consolas"
                                PlaceholderText="--fullscreen --demo" />

                    <!-- 窗口大小（v0.1.10：默认 / 与启动器一致 / 自定义） -->
                    <TextBlock Text="{DynamicResource S.Set.Resolution}" FontWeight="Medium" Margin="0,16,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.ResolutionHint}" Style="{StaticResource HmHint}" Margin="0,0,0,8" />
                    <WrapPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbWindowMode" MinHeight="30" MinWidth="200"
                                  SelectionChanged="CmbWindowMode_Changed">
                            <ComboBoxItem Content="{DynamicResource S.Set.WinModeDefault}" Tag="default" IsSelected="True" />
                            <ComboBoxItem Content="{DynamicResource S.Set.WinModeMatch}" Tag="match-launcher" />
                            <ComboBoxItem Content="{DynamicResource S.Set.WinModeCustom}" Tag="custom" />
                        </ComboBox>
                        <StackPanel x:Name="PnlWindowSize" Orientation="Horizontal" Margin="12,0,0,0" Visibility="Collapsed">
                            <ui:TextBox x:Name="TxtGameWidth" MinHeight="30" Width="110"
                                        PlaceholderText="1280" TextAlignment="Center" />
                            <TextBlock Text="×" FontSize="16" VerticalAlignment="Center" Margin="8,0" />
                            <ui:TextBox x:Name="TxtGameHeight" MinHeight="30" Width="110"
                                        PlaceholderText="720" TextAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>

                    <CheckBox x:Name="ChkFullscreen" Content="{DynamicResource S.Set.Fullscreen}" Margin="0,14,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.FullscreenHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12"
                               TextWrapping="Wrap" />

                    <CheckBox x:Name="ChkSkipOnboarding" Content="{DynamicResource S.Set.SkipOnboarding}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.SkipOnboardingHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource S.Set.GameLang}" FontWeight="Medium" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbGameLang" MinHeight="30" Width="240" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="{DynamicResource S.Set.GameLangKeep}" Tag="" IsSelected="True" />
                        <ComboBoxItem Content="简体中文（zh_CN）" Tag="zh_CN" />
                        <ComboBoxItem Content="English (en_US)" Tag="en_US" />
                    </ComboBox>

                    <CheckBox x:Name="ChkHideOnStart" Content="{DynamicResource S.Set.HideOnStart}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.HideOnStartHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12" />

                    <CheckBox x:Name="ChkExitOnGameExit" Content="{DynamicResource S.Set.ExitOnGameExit}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.ExitOnGameExitHint}" Style="{StaticResource HmHint}" Margin="24,0,0,2"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ===== 7. 网络 ===== -->
            <Border Style="{StaticResource HmCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Set.NetworkGroup}" />
                            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Set.NetworkGroupHint}" />
                        </StackPanel>
                    </StackPanel>

                    <CheckBox x:Name="ChkMirror" Content="{DynamicResource S.Set.Mirror}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.MirrorHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12" />

                    <!-- v0.1.1：下载线程数（多线程预取） -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource S.Set.DownloadThreads}" FontWeight="Medium" />
                            <TextBlock Text="{DynamicResource S.Set.DownloadThreadsHint}" Style="{StaticResource HmHint}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:NumberBox x:Name="NumDownloadThreads" Grid.Column="1" MinWidth="110" MinHeight="32"
                                      VerticalAlignment="Center" Minimum="1" Maximum="256" Value="64"
                                      SmallChange="1" LargeChange="16" />
                    </Grid>

                    <CheckBox x:Name="ChkVerifyFiles" Content="{DynamicResource S.Set.VerifyEvery}" Margin="0,0,0,2" />
                    <TextBlock Text="{DynamicResource S.Set.VerifyEveryHint}" Style="{StaticResource HmHint}" Margin="24,0,0,12"
                               TextWrapping="Wrap" />

                    <TextBlock Text="{DynamicResource S.Set.AzureId}" FontWeight="Medium" Margin="0,0,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.AzureIdHint}" Style="{StaticResource HmHint}" Margin="0,0,0,8" />
                    <ui:TextBox x:Name="TxtAzureId" MinHeight="30" />
                    <ui:Button Content="{DynamicResource S.Azure.OpenGuide}" Appearance="Transparent" Padding="8,2,8,2"
                               Margin="0,6,0,0" HorizontalAlignment="Left" Click="BtnAzureGuide_Click" />

                    <TextBlock Text="{DynamicResource S.Set.CfKey}" FontWeight="Medium" Margin="0,16,0,6" />
                    <TextBlock Text="{DynamicResource S.Set.CfKeyHint}" Style="{StaticResource HmHint}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtCfKey" MinHeight="30" Margin="0,0,8,0" />
                        <ui:Button Grid.Column="1" Content="{DynamicResource S.Set.CfKeyGet}" MinHeight="30"
                                   Icon="{ui:SymbolIcon Link24}" Click="BtnCfKey_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <ui:Button Content="{DynamicResource S.Set.Save}" Appearance="Primary" Icon="{ui:SymbolIcon Save24}"
                       Click="BtnSave_Click" MinWidth="160" MinHeight="30" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
