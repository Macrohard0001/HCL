<Page x:Class="HardmacroCraft.Views.TaskCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="32,24,32,24" MaxWidth="880" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Task.Subtitle}"
                       Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Task.ClickHint}" Margin="0,0,0,12" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <ui:Button Content="{DynamicResource S.Task.Clear}" Icon="{ui:SymbolIcon Delete24}"
                       MinHeight="30" Click="BtnClear_Click" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Style="{StaticResource HmScrollViewer}">
            <StackPanel x:Name="PnlTasks" />
        </ScrollViewer>
    </Grid>
</Page>
