<Page x:Class="HardmacroCraft.Views.DownloadGamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- v0.1.8：主容器不再滚动（响应式）—— 标题固定，版本列表撑满剩余空间（仅列表内滚），进度卡钉底 -->
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
                <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Dl.Subtitle}" />
                <ui:Button Grid.Column="1" x:Name="BtnRefreshVersions" MinHeight="30" Margin="12,0,0,0"
                           Content="{DynamicResource S.Dl.Reload}" Icon="{ui:SymbolIcon ArrowClockwise24}"
                           Click="BtnRefreshVersions_Click" />
            </Grid>
        </StackPanel>

        <!-- ============ 原版：PCL 式版本浏览器（v0.1.8：列表撑满剩余空间，仅列表内滚） ============ -->
        <Border Grid.Row="1" Style="{StaticResource HmCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <!-- 草方块图标（原版 Minecraft 标志性意象），微软式小图标直接内联 -->
                    <Image Source="/Assets/grass.png" Width="20" Height="20" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HmSectionTitle}" Text="{DynamicResource S.Dl.Vanilla}" />
                        <TextBlock Style="{StaticResource HmHint}" Text="{DynamicResource S.Dl.VanillaHint}" />
                    </StackPanel>
                </StackPanel>

                <!-- 过滤行：分类 chips + 搜索框（PCL 式） -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnFAll" MinHeight="32" Padding="12,0" Margin="0,0,6,0"
                                   Content="{DynamicResource S.Dl.FilterAll}" Click="BtnFilter_Click" />
                        <ui:Button x:Name="BtnFRelease" MinHeight="32" Padding="12,0" Margin="0,0,6,0"
                                   Appearance="Primary"
                                   Content="{DynamicResource S.Dl.Release}" Click="BtnFilter_Click" />
                        <ui:Button x:Name="BtnFSnapshot" MinHeight="32" Padding="12,0" Margin="0,0,6,0"
                                   Content="{DynamicResource S.Dl.Snapshot}" Click="BtnFilter_Click" />
                        <!-- fix9：愚人节版独立分类（PCL 同款五分类） -->
                        <ui:Button x:Name="BtnFApril" MinHeight="32" Padding="12,0" Margin="0,0,6,0"
                                   Content="{DynamicResource S.Dl.FilterApril}" Click="BtnFilter_Click" />
                        <ui:Button x:Name="BtnFOld" MinHeight="32" Padding="12,0"
                                   Content="{DynamicResource S.Dl.Old}" Click="BtnFilter_Click" />
                    </StackPanel>
                    <ui:TextBox Grid.Column="1" x:Name="TxtVanillaSearch" MinHeight="32" MaxWidth="260"
                                Margin="12,0,0,0" HorizontalAlignment="Right"
                                PlaceholderText="{DynamicResource S.Dl.SearchHint}"
                                TextChanged="TxtVanillaSearch_TextChanged" />
                </Grid>

                <!-- 版本列表（撑满剩余空间，仅列表内滚；v0.1.8 列表虚拟化回收） -->
                <ListBox Grid.Row="2" x:Name="LstVanilla" MinHeight="180"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Style="{StaticResource HmListBox}"
                         BorderThickness="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                         SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="34" Height="34" CornerRadius="8" Grid.Column="0"
                                        Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                                    <!-- PCL 式草方块图标 -->
                                    <Image Source="/Assets/grass.png" Width="26" Height="26"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <!-- 类型徽章（正式 / 快照 / 远古） -->
                                        <Border CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Background="{Binding TypeBadgeBg}" BorderBrush="{Binding TypeBadgeFg}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding TypeText}" FontSize="10.5"
                                                       Foreground="{Binding TypeBadgeFg}" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Background="#3327C93F" BorderBrush="#27C93F" BorderThickness="1"
                                                Visibility="{Binding LatestVisibility}">
                                            <TextBlock Text="{DynamicResource S.Dl.BadgeLatest}" FontSize="10.5"
                                                       Foreground="#2FD155" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                BorderThickness="1" Visibility="{Binding InstalledVisibility}">
                                            <TextBlock Text="{DynamicResource S.Dl.InstalledBadge}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TimeText}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <TextBlock FontSize="12" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Desc}" />
                                    </StackPanel>
                                </StackPanel>

                                <ui:Button Grid.Column="2" MinHeight="32" Padding="14,0" VerticalAlignment="Center"
                                           Content="{DynamicResource S.Dl.Install}"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Appearance="Primary" Click="BtnVanillaRowInstall_Click" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- v0.15.0：PCL 式翻页条（版本列表不再 Take(300) 截断，翻页浏览全部结果） -->
                <StackPanel Grid.Row="3" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel x:Name="PnlPager" Orientation="Horizontal" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtPageOf" Style="{StaticResource HmHint}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="TxtVanillaEmpty" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Style="{StaticResource HmHint}" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- v0.15.0：居中加载过渡层（指示器页面居中，替代底部旋转指示器） -->
        <Border Grid.Row="1" x:Name="PnlLoading" Visibility="Collapsed"
                Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.82" CornerRadius="10"
                KeyboardNavigation.TabNavigation="None" Focusable="False">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ui:ProgressRing Width="42" Height="42" IsIndeterminate="True" />
                <TextBlock x:Name="TxtLoading" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- v0.15.0：底部常驻提示行移除（PCL 式）—— 状态文本只在有话要说时短暂出现 -->
        <TextBlock Grid.Row="2" x:Name="TxtStatus" Style="{StaticResource HmHint}" Margin="0,10,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   MaxHeight="56" Visibility="Collapsed" />
    </Grid>
</Page>
