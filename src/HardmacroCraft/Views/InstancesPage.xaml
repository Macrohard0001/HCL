<Page x:Class="HardmacroCraft.Views.InstancesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- v0.1.11 实例管理：运行中的游戏实例集中在此查看 / 管理（自主页实例卡迁移而来） -->
    <Grid Margin="32,24,32,24" MaxWidth="880" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- v0.1.13：去除页内主标题（侧栏已标明页面），仅保留副标题 -->
            <TextBlock Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Inst.Subtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource HmScrollViewer}">
            <StackPanel>
                <TextBlock x:Name="TxtEmpty" Text="{DynamicResource S.Inst.Empty}"
                           FontSize="13" Margin="0,32,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="PnlInstances" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
