<ui:FluentWindow x:Class="HardmacroCraft.Views.AuthlibLoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource S.Authlib.Title}"
                 Width="540" Height="568"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- fix5：ExtendsContentIntoTitleBar=true 时必须自建 TitleBar 才有关闭按钮 -->
        <ui:TitleBar Grid.Row="0" Title="{DynamicResource S.Authlib.Title}"
                     Padding="10,8,0,0" ShowMaximize="False" />
        <StackPanel Grid.Row="1" Margin="32,12,32,24">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10"
                    Background="{DynamicResource SystemAccentColorPrimaryBrush}">
                <ui:SymbolIcon Symbol="Globe24" FontSize="20" Foreground="White" />
            </Border>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource S.Authlib.Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource S.Authlib.Subtitle}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- 服务器地址（预设下拉 + 可输入，PCL 同款） -->
        <TextBlock Text="{DynamicResource S.Authlib.Server}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ComboBox x:Name="CmbServer" IsEditable="True" MinHeight="30" Margin="0,0,0,12" />

        <!-- 邮箱 -->
        <TextBlock Text="{DynamicResource S.Authlib.User}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:TextBox x:Name="TxtUser" MinHeight="30" Margin="0,0,0,12"
                    PlaceholderText="{DynamicResource S.Authlib.UserHint}" />

        <!-- 密码 -->
        <TextBlock Text="{DynamicResource S.Authlib.Password}" FontSize="13" FontWeight="Medium" Margin="0,0,0,6"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        <ui:PasswordBox x:Name="TxtPassword" MinHeight="30" Margin="0,0,0,10" />

        <!-- 记住密码 + 自动登录 + 注册链接（PCL 同款） -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkRemember" Content="{DynamicResource S.Authlib.Remember}"
                      FontSize="12.5" VerticalAlignment="Center"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <CheckBox Grid.Column="1" x:Name="ChkAutoLogin" Content="{DynamicResource S.Authlib.AutoLogin}"
                      FontSize="12.5" Margin="14,0,0,0" IsEnabled="False" VerticalAlignment="Center"
                      ToolTip="{DynamicResource S.Authlib.AutoLoginHint}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Grid.Column="2" x:Name="TxtRegister" VerticalAlignment="Center"
                       FontSize="12.5" Visibility="Collapsed">
                <Hyperlink x:Name="LnkRegister" Click="LnkRegister_Click"
                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}">
                    <Run Text="{DynamicResource S.Authlib.Register}" />
                </Hyperlink>
            </TextBlock>
        </Grid>

        <ProgressBar x:Name="PbLogin" IsIndeterminate="True" Height="6" Margin="0,0,0,10"
                     Visibility="Collapsed" />
        <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" FontSize="13" MinHeight="40"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BtnCancel" Content="{DynamicResource S.Login.Cancel}"
                       HorizontalAlignment="Left" MinHeight="32" Click="BtnCancel_Click" />
            <ui:Button Grid.Column="1" x:Name="BtnLogin" Appearance="Primary" MinHeight="30" MinWidth="140"
                       Content="{DynamicResource S.Authlib.Login}" Icon="{ui:SymbolIcon PersonKey24}"
                       Click="BtnLogin_Click" />
        </Grid>
    </StackPanel>
    </Grid>
</ui:FluentWindow>
