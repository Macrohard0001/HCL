<Page x:Class="HardmacroCraft.Views.ModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- fix5：外层滚动容器（此前页面无滚动，小窗口时内容被截断无法滚动） -->
    <ScrollViewer Style="{StaticResource HmScrollViewer}">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,2">
            <StackPanel Orientation="Horizontal">
                <Border Width="5" Height="24" CornerRadius="2.5"
                        Background="{DynamicResource SystemAccentColorPrimaryBrush}"
                        VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource HmPageTitle}" Text="{DynamicResource S.Mod.Title}" />
            </StackPanel>
            <TextBlock x:Name="TxtSubtitle" Style="{StaticResource HmPageSubtitle}" Text="{DynamicResource S.Mod.Subtitle}" />
        </StackPanel>

        <!-- 搜索工具条（fix5：自适应换行，小窗口不再挤丢搜索框） -->
        <Border Grid.Row="1" Style="{StaticResource HmCard}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="TxtQuery" MinHeight="38" MinWidth="160"
                                PlaceholderText="{DynamicResource S.Mod.SearchHint}" KeyDown="TxtQuery_KeyDown" />
                    <ui:Button Grid.Column="1" MinHeight="38" MinWidth="96" Margin="8,0,0,0"
                               Content="{DynamicResource S.Mod.Search}"
                               Appearance="Primary" Icon="{ui:SymbolIcon Search24}" Click="BtnSearch_Click" />
                </Grid>
                <WrapPanel Margin="0,8,0,0">
                    <ComboBox x:Name="CmbPlatform" MinHeight="38" MinWidth="112" Margin="0,0,8,4"
                              SelectionChanged="CmbPlatform_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource S.Mod.PlatformModrinth}" IsSelected="True" Tag="modrinth" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.PlatformCF}" Tag="curseforge" />
                    </ComboBox>
                    <ComboBox x:Name="CmbSort" MinHeight="38" MinWidth="118" Margin="0,0,8,4"
                              SelectionChanged="CmbSort_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource S.Mod.SortRelevance}" IsSelected="True" Tag="relevance" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.SortDownloads}" Tag="downloads" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.SortFollows}" Tag="follows" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.SortNewest}" Tag="newest" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.SortUpdated}" Tag="updated" />
                    </ComboBox>
                    <ComboBox x:Name="CmbType" MinHeight="38" MinWidth="118" Margin="0,0,8,4"
                              SelectionChanged="CmbType_SelectionChanged">
                        <ComboBoxItem Content="{DynamicResource S.Mod.TypeMod}" IsSelected="True" Tag="mod" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.TypeResource}" Tag="resourcepack" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.TypeShader}" Tag="shader" />
                        <ComboBoxItem Content="{DynamicResource S.Mod.TypeData}" Tag="datapack" />
                    </ComboBox>
                    <ComboBox x:Name="CmbLoader" MinHeight="38" MinWidth="104" Margin="0,0,8,4"
                              ToolTip="{DynamicResource S.Mod.LoaderHint}">
                        <ComboBoxItem Content="{DynamicResource S.Mod.LoaderAll}" IsSelected="True" Tag="any" />
                        <ComboBoxItem Content="Forge" Tag="forge" />
                        <ComboBoxItem Content="Fabric" Tag="fabric" />
                        <ComboBoxItem Content="NeoForge" Tag="neoforge" />
                        <ComboBoxItem Content="Quilt" Tag="quilt" />
                    </ComboBox>
                    <ComboBox x:Name="CmbTargetVersion" MinHeight="38" MinWidth="180" Margin="0,0,8,4" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 搜索结果（PCL 式信息卡行；fix5：限高使页面可整体滚动） -->
        <ListBox Grid.Row="2" x:Name="LstResults" Style="{StaticResource HmListBox}" MaxHeight="460">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Checked="ChkSelect_Changed" Unchecked="ChkSelect_Changed" />
                        <Border Grid.Column="1" Width="52" Height="52" CornerRadius="9"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding AuthorText}" FontSize="11.5" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,5"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxHeight="34" TextWrapping="Wrap" />
                            <!-- 徽章行：分类 / 下载 / 关注 / 更新时间 / 支持版本 -->
                            <ItemsControl ItemsSource="{Binding Badges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <ui:Button Grid.Column="3" Content="{DynamicResource S.Mod.Download}"
                                   Appearance="Primary" MinHeight="36" VerticalAlignment="Center"
                                   Click="BtnDownload_Click" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 本机 Mod 管理（PCL 式：列出 / 禁用 / 启用 / 删除） -->
        <!-- 批量操作条（PCL 式：勾选后一键批量安装） -->
        <Border Grid.Row="3" x:Name="PnlBatch" Style="{StaticResource HmCard}" Margin="0,0,0,12"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="CheckboxChecked24" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                <TextBlock Text="{DynamicResource S.Mod.BatchTitle}" Style="{StaticResource HmSectionTitle}"
                           FontSize="13" Margin="8,0,14,0" VerticalAlignment="Center" />
                <ui:Button Content="{DynamicResource S.Mod.BatchAll}" MinHeight="34" MinWidth="76" Margin="0,0,8,0"
                           Click="BtnSelectAll_Click" />
                <ui:Button Content="{DynamicResource S.Mod.BatchNone}" MinHeight="34" MinWidth="76" Margin="0,0,8,0"
                           Click="BtnClearSelect_Click" />
                <ui:Button x:Name="BtnBatchDownload" Content="{DynamicResource S.Mod.BatchGo}"
                           Appearance="Primary" MinHeight="34" MinWidth="130" Margin="0,0,8,0"
                           Icon="{ui:SymbolIcon ArrowDownload24}" IsEnabled="False"
                           Click="BtnBatchDownload_Click" />
                <TextBlock Text="{DynamicResource S.Mod.BatchHint}" FontSize="11.5" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- 加载更多（Modrinth 分页） -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <ui:Button x:Name="BtnMore" Content="{DynamicResource S.Mod.LoadMore}"
                       Icon="{ui:SymbolIcon ChevronDown24}" MinHeight="34" MinWidth="160"
                       Click="BtnMore_Click" Visibility="Collapsed" />
        </StackPanel>

        <Border Grid.Row="5" Style="{StaticResource HmCard}" Margin="0,12,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16"
                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource S.Mod.Local}" Style="{StaticResource HmSectionTitle}"
                                   FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{DynamicResource S.Mod.OpenDir}"
                               Icon="{ui:SymbolIcon Folder24}" MinHeight="34" Margin="0,0,8,0"
                               Click="BtnOpenModDir_Click" />
                    <ui:Button Grid.Column="2" Content="{DynamicResource S.Ver.Refresh}"
                               Icon="{ui:SymbolIcon ArrowClockwise24}" MinHeight="34" Margin="0,0,8,0"
                               Click="BtnLocalRefresh_Click" />
                    <ui:Button Grid.Column="3" Content="{DynamicResource S.Mod.Toggle}"
                               Icon="{ui:SymbolIcon EyeOff24}" MinHeight="34" Margin="0,0,8,0"
                               Click="BtnToggleMod_Click" />
                    <ui:Button Grid.Column="4" Content="{DynamicResource S.Ver.Delete}"
                               Appearance="Danger" Icon="{ui:SymbolIcon Delete24}" MinHeight="34"
                               Click="BtnDeleteMod_Click" />
                </Grid>
                <ListBox x:Name="LstLocalMods" MinHeight="110" MaxHeight="170"
                         Style="{StaticResource HmListBox}" BorderThickness="0"
                         SelectionMode="Single" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6" Margin="0,10,0,0">
            <ProgressBar x:Name="PbProgress" Height="6" IsIndeterminate="False" Maximum="100" />
            <TextBlock x:Name="TxtProgress" Style="{StaticResource HmHint}" Margin="0,6,0,0"
                       TextWrapping="Wrap" MaxHeight="70" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
