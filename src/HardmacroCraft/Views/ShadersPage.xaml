<Page x:Class="HardmacroCraft.Views.ShadersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- v0.1.13 光影包下载（PCL 同款独立页）：Modrinth shader 分类，默认显示推荐内容；
         主容器不滚动 —— 结果列表撑满剩余空间，仅列表内滚；
         底部不再放进度条，改为容器内旋转加载指示器（与文本同行）。 -->
    <Grid Margin="32,16,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HmPageSubtitle}"
                   Text="{DynamicResource S.Sh.Subtitle}" Margin="0,0,0,10" />

        <!-- 工具条：目标版本 + 搜索 + 排序 + 打开目录 -->
        <Border Grid.Row="1" Style="{StaticResource HmCard}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TxtQuery" MinHeight="30" Margin="0,0,8,0"
                            PlaceholderText="{DynamicResource S.Sh.SearchHint}"
                            KeyDown="TxtQuery_KeyDown" />
                <ComboBox x:Name="CmbVersion" Grid.Column="1" MinWidth="150" MinHeight="30" Margin="0,0,8,0"
                          ToolTip="{DynamicResource S.Sh.VersionTip}"
                          SelectionChanged="CmbVersion_SelectionChanged" />
                <ui:Button Grid.Column="2" x:Name="BtnSearch" MinHeight="30" MinWidth="88" Margin="0,0,8,0"
                           Content="{DynamicResource S.Mod.Search}" Appearance="Primary"
                           Icon="{ui:SymbolIcon Search24}" Click="BtnSearch_Click" />
                <ui:Button Grid.Column="3" MinHeight="30" MinWidth="34"
                           Icon="{ui:SymbolIcon Folder24}"
                           Content="{DynamicResource S.Sh.OpenDir}" Click="BtnOpenDir_Click"
                           ToolTip="{DynamicResource S.Sh.OpenDirTip}" />
            </Grid>
        </Border>

        <!-- 结果列表 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListBox Grid.Row="0" x:Name="LstResults" Style="{StaticResource HmListBox}"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="12,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="9"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                <Image Source="{Binding IconUrl}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding AuthorText}" FontSize="11.5" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,2,0,5"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Badges}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,1.5" Margin="0,0,6,0"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="{DynamicResource S.Sh.Install}"
                                       Appearance="Primary" MinHeight="32" VerticalAlignment="Center"
                                       Click="BtnInstall_Click" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空结果提示 -->
            <StackPanel Grid.Row="0" x:Name="PnlEmpty" Visibility="Collapsed" Margin="0,40"
                        HorizontalAlignment="Center">
                <ui:SymbolIcon Symbol="SearchInfo24" FontSize="34" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="TxtEmpty" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- 加载更多（Modrinth 分页） -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <ui:Button x:Name="BtnMore" Content="{DynamicResource S.Mod.LoadMore}"
                           Icon="{ui:SymbolIcon ChevronDown24}" MinHeight="32" MinWidth="160"
                           Click="BtnMore_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- v0.1.13：底部旋转加载指示器（容器内，替代旧进度条）+ 状态文本 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0" x:Name="PnlStatus">
            <ui:ProgressRing x:Name="RingStatus" Width="18" Height="18" IsIndeterminate="True"
                             Visibility="Collapsed" />
            <TextBlock x:Name="TxtStatus" Style="{StaticResource HmHint}" VerticalAlignment="Center"
                       Margin="8,0,0,0" TextWrapping="Wrap" MaxHeight="60" />
        </StackPanel>
    </Grid>
</Page>
