<!--
    v0.15.9：Metro（Win10 怀旧）主窗口壳 —— 双壳方案之二。

    ThemeStyle=metro 时 App.OnStartup 用本壳替代 Fluent 壳（MainWindow）：
    - 窗框改用 MahApps MetroWindow（Win10 式方形标题栏 + 系统按钮，不再有
      Wpf.Ui 的 Win11 Mica 窗框）；MahApps 自带 Themes/generic.xaml，
      模板永远可用，不受全局字典组合影响。
    - 导航窗格手绘（Win10 NavigationView 式：汉堡按钮折叠 224px/48px 窄轨），
      标签用 DynamicResource（跟随语言热切换），选中项 Tag = 页面类型。
    - 页面与 Fluent 壳完全共用（Page 缓存实例，切回不再重建，避免页面内
      订阅的定时器 / 事件泄漏）。
    窗格滚轮滚动由原生 ScrollViewer 承担（v0.15.9 滚轮修复同步生效）。
-->
<mah:MetroWindow x:Class="HardmacroCraft.MetroMainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:views="clr-namespace:HardmacroCraft.Views"
                 Title="Hardmacro Craft Launcher"
                 Width="960" Height="540"
                 MinWidth="900" MinHeight="520"
                 WindowStartupLocation="CenterScreen"
                 ShowTitleBar="True"
                 WindowTransitionsEnabled="False"
                 Icon="pack://application:,,,/Assets/icon.jpg"
                 Background="{DynamicResource ApplicationBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 导航项：Win10 式图标 + 标签行（窄轨时隐藏标签） -->
        <Style x:Key="MetroNavItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航窗格（Win10 NavigationView 式） -->
        <Border x:Name="PaneBorder" Grid.Column="0" Width="224"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 汉堡按钮（折叠 224 ↔ 48） -->
                <Button x:Name="Hamburger" DockPanel.Dock="Top" Width="48" Height="48"
                        HorizontalAlignment="Left" Background="Transparent"
                        BorderThickness="0" Click="Hamburger_Click"
                        ToolTip="{DynamicResource S.Nav.Home}">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE700;"
                               FontSize="16" />
                </Button>

                <!-- 主导航（Win10 式：分组 + 项） -->
                <ListBox x:Name="NavList" DockPanel.Dock="Top" Background="Transparent"
                         BorderThickness="0" SelectionMode="Single"
                         ItemContainerStyle="{StaticResource MetroNavItem}"
                         SelectionChanged="NavList_SelectionChanged"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Tag="{x:Type views:HomePage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE80F;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Home}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>

                    <!-- 下载分组（Win10 式可折叠组头） -->
                    <Expander Header="{DynamicResource S.Nav.DownloadMenu}" IsExpanded="False"
                              Margin="2,1" Background="Transparent"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Expander.Style>
                            <Style TargetType="Expander">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Expander">
                                            <StackPanel>
                                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                              HorizontalContentAlignment="Left" Background="Transparent"
                                                              BorderThickness="0" Padding="8,10">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets"
                                                                   Text="&#xE896;" FontSize="16" VerticalAlignment="Center" />
                                                        <TextBlock Text="{TemplateBinding Header}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed"
                                                                  ContentSource="Content" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Expander.Style>
                        <StackPanel>
                            <ListBoxItem Tag="{x:Type views:DownloadGamePage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE896;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.DownloadGame}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:ModsPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE71D;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Mods}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:ModpacksPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Modpacks}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:ShadersPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE706;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Shaders}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:ResourcePacksPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE790;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Resources}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:DatapacksPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Datapacks}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem Tag="{x:Type views:ModSetupPage}">
                                <DockPanel Height="38" Margin="4,0">
                                    <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.ModSetup}" VerticalAlignment="Center" FontSize="13"
                                               Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                                </DockPanel>
                            </ListBoxItem>
                        </StackPanel>
                    </Expander>

                    <ListBoxItem Tag="{x:Type views:VersionsPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Versions}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Type views:InstancesPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE7FC;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Instances}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                    <!-- v0.15.9：联机（LAN 发现 + P2P/中转预留） -->
                    <ListBoxItem Tag="{x:Type views:MultiplayerPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE774;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Multiplayer}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                    <!-- v0.15.10：种子工具（史莱姆挂机点查询） -->
                    <ListBoxItem Tag="{x:Type views:ToolsPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE90F;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Tools}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Type views:TaskCenterPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Tasks}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 底部：设置 / 关于 -->
                <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" Background="Transparent"
                         BorderThickness="0" SelectionMode="Single"
                         ItemContainerStyle="{StaticResource MetroNavItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Tag="{x:Type views:SettingsPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.Settings}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{x:Type views:AboutPage}">
                        <DockPanel Height="40" Margin="4,0">
                            <TextBlock DockPanel.Dock="Left" Width="40" FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource S.Nav.About}" VerticalAlignment="Center"
                                       Visibility="{Binding IsChecked, ElementName=Hamburger, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 中部弹性区 -->
                <Border />
            </DockPanel>
        </Border>

        <!-- 页面宿主（Page 缓存实例）。必须是 Frame：WPF 规定 Page 的父级只能是
             Window 或 Frame，ContentControl 承载会在布局时抛
             "Page can have only Window or Frame as parent"（v0.15.9 事故根因，
             crash.log 2026-11-24，布局循环重抛 + 逐次弹窗 = 报错弹窗风暴） -->
        <Frame x:Name="PageHost" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               JournalOwnership="OwnsJournal"
               Focusable="False" />
    </Grid>
</mah:MetroWindow>
