<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HardmacroCraftLauncher</AssemblyName>
    <AssemblyTitle>Hardmacro Craft Launcher</AssemblyTitle>
    <Product>Hardmacro Craft Launcher</Product>
    <Authors>Fox_Ryn (Macrohard0001)</Authors>
    <Copyright>Copyright (c) 2026 Fox_Ryn (Macrohard0001)</Copyright>
    <FileDescription>Hardmacro Craft Launcher</FileDescription>
    <RootNamespace>HardmacroCraft</RootNamespace>
    <Version>0.1.3</Version>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
    <FileVersion>0.1.3.0</FileVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- v0.1.3 内存优化配套：工作站并发 GC（桌面单窗口应用的默认且最优策略，显式声明防覆盖）。
         配合 MemoryManager（重大操作后 GC + 工作集回收 / 空闲定时优化）降低常驻内存。 -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- 单文件压缩 + partial 裁剪：163.9MB → 70.8MB（压缩 -57%）→ 40.2MB（裁剪再 -43%）。
         TrimMode=partial 只裁剪自声明可裁剪的 BCL / SDK 投影（System.Private.CoreLib 16MB→3.5MB、
         Windows.SDK.NET 24.9MB→约 7MB），WPF / 应用 / CmlLib 程序集完整保留，
         且不可裁剪程序集的引用全部作为根分析 —— 保留自包含免运行环境特性的同时大幅减体积。
         SDK 默认报 NETSDK1168（WPF+trim 官方未背书），partial 模式下实测构建与全量测试通过，
         用官方提供的 _SuppressWpfTrimError 开关放行。 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <_SuppressWpfTrimError>true</_SuppressWpfTrimError>
    <!-- 异常消息只保留英文（与 SatelliteResourceLanguages=en 一致），去掉 BCL 内嵌的多语言资源 -->
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- fix3：原生库（wpfgfx / PresentationNative 等）打进单文件并在 exe 旁自解压，
         避免部分环境（杀软拦截临时目录 / 只读目录）下 WPF 原生库加载失败无法启动 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\grass.png" />
    <Resource Include="Assets\Anvil.png" />
    <Resource Include="Assets\NeoForge.png" />
    <Resource Include="Assets\Fabric.png" />
    <Resource Include="Assets\Quilt.png" />
  </ItemGroup>

</Project>
