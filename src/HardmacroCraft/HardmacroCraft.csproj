<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>HardmacroCraftLauncher</AssemblyName>
    <AssemblyTitle>Hardmacro Craft Launcher</AssemblyTitle>
    <Product>Hardmacro Craft Launcher</Product>
    <Authors>Fox_Ryn (Macrohard0001)</Authors>
    <Copyright>Copyright (c) 2026 Fox_Ryn (Macrohard0001)</Copyright>
    <FileDescription>Hardmacro Craft Launcher</FileDescription>
    <RootNamespace>HardmacroCraft</RootNamespace>
    <Version>0.1.13</Version>
    <AssemblyVersion>0.1.13.0</AssemblyVersion>
    <FileVersion>0.1.13.0</FileVersion>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- v0.1.3 内存优化配套：工作站并发 GC（桌面单窗口应用的默认且最优策略，显式声明防覆盖）。
         配合 MemoryManager（重大操作后 GC + 工作集回收 / 空闲定时优化）降低常驻内存。 -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- 单文件压缩：163.9MB → 70.8MB（-57%）。
         ⚠ v0.1.2/v0.1.3 曾启用 PublishTrimmed(partial) 裁剪到 40.2MB，实测在真机上
         启动即崩（XamlParseException → TypeLoadException @ UnsafeNativeMethods.FindMimeFromData，
         加载 MainWindow.xaml 内嵌图标资源时触发）——WPF + 裁剪官方不支持（NETSDK1168），
         partial 模式沙盒测试全绿也测不出 publish 产物的问题，v0.1.4 起永久禁用裁剪。 -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- fix3：原生库（wpfgfx / PresentationNative 等）打进单文件并在 exe 旁自解压，
         避免部分环境（杀软拦截临时目录 / 只读目录）下 WPF 原生库加载失败无法启动 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icon.ico" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\grass.png" />
    <Resource Include="Assets\Anvil.png" />
    <Resource Include="Assets\NeoForge.png" />
    <Resource Include="Assets\Fabric.png" />
    <Resource Include="Assets\Quilt.png" />
    <Resource Include="Assets\steve.png" />
    <Resource Include="Assets\alex.png" />
  </ItemGroup>

</Project>
