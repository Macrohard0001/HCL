<!--
    v0.15.9：Metro（Win10 怀旧）皮肤 · 深色变体。
    压住 Wpf.Ui 主题字典的 WinUI 填充键（合并字典后位优先）：ui: 控件保留
    Fluent 模板（图标 / 结构不动），但填色换成 Win10 深色实底 ——
    按钮 #333333 实底 + #454545 描边，悬停亮蓝描边 #0078D7；
    输入框深底；卡片实色无半透明。经 ApplyMetroOverlay 按变体加载，
    SwapMetroVariant 深浅色切换时同位替换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 应用底色：Win10 深色应用底 -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FF202020" />

    <!-- 按钮：Win10 深色（实底 / 暗描边 / 悬停蓝描边） -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FF3F3F3F" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF454545" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF3C3C3C" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFFFF" />

    <!-- 强调按钮：经典 Win10 蓝（悬停 / 按下加深，非半透明） -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF106EBE" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF005A9E" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />

    <!-- 通用控件填充：Win10 深色实底 -->
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#FF333333" />
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ControlFillColorTertiary" Color="#FF404040" />
    <SolidColorBrush x:Key="ControlFillColorDisabled" Color="#FF2E2E2E" />
    <SolidColorBrush x:Key="ControlFillColorInputActive" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefault" Color="#FF333333" />

    <!-- 微妙填充（卡片 / 列表项悬停）：实色深灰 -->
    <SolidColorBrush x:Key="SubtleFillColorSecondary" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="SubtleFillColorTertiary" Color="#FF404040" />

    <!-- 卡片：实色 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondary" Color="#FF333333" />

    <!-- 描边：Win10 式硬边 -->
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#FF454545" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#FF5A5A5A" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiary" Color="#FF4A4A4A" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolid" Color="#FF3D3D3D" />

    <!-- 组合框：深底实色（展开态深底 + 蓝描边） -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FF2B2B2B" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#FF0078D7" />

    <!-- 复选框 / 开关底色 -->
    <SolidColorBrush x:Key="CheckBoxBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF0078D7" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF106EBE" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#FF2E2E2E" />

    <!-- 焦点框：Win10 式白（深色模式） -->
    <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="#FFFFFFFF" />
</ResourceDictionary>
