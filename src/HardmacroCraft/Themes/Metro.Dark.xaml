<!--
    v0.15.4：Metro（Win10 怀旧）主题覆盖层 · 深色变体。
    v0.15.3 的手绘覆盖层只压了圆角和强调色，用户反馈「不对」——升级为真库方案：

    1) MahApps.Metro（WPF 事实标准的 Metro 库）隐式样式接管全部标准控件：
       ComboBox(67) / ListBox(17) / CheckBox(16) / ProgressBar(5) 等
       全部换成 MahApps 的 Win8/Win10 式平面直角样式（深浅色由本字典变体决定）。
    2) Wpf.Ui 侧控件（ui:Button 等 87 处派生控件，第三方库的隐式样式按 WPF 规则
       无法作用于派生类型）继续走资源覆盖：直角 + 经典 Win10 蓝 #0078D7。
    3) 窗体：App.ApplyTheme 在 Metro 模式关闭云母并把 DWM 圆角偏好设为
       DoNotRound（去掉 Win11 圆角窗体），见 App.ApplyMetroOverlay / MainWindow。

    切换管线：App.ApplyMetroOverlay(on, theme) 按 ThemeStyle 挂载本字典或
    Metro.Light.xaml，深浅色变化（含跟随系统的监听）会整体重挂。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- MahApps 深色主题 + 隐式控件样式（合并位在 Wpf.Ui 之后，隐式样式后位优先） -->
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.xaml" />
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Wpf.Ui 侧覆盖：直角（Win10 / Metro 形状语言） ===== -->
    <CornerRadius x:Key="ControlCornerRadius">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0,0,0,0</CornerRadius>
    <CornerRadius x:Key="PopupCornerRadius">0,0,0,0</CornerRadius>

    <!-- ===== Wpf.Ui 侧覆盖：经典 Win10 强调色 ===== -->
    <Color x:Key="SystemAccentColor">#FF0078D7</Color>
    <Color x:Key="SystemAccentColorPrimary">#FF0063B1</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF004278</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF00284E</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#FF0078D7" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#FF0063B1" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FF004278" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#FF00284E" />
</ResourceDictionary>
