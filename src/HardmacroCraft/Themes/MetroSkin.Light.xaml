<!--
    v0.15.9：Metro（Win10 怀旧）皮肤 · 浅色变体。
    压住 Wpf.Ui 主题字典的 WinUI 填充键（合并字典后位优先）：ui: 控件保留
    Fluent 模板（图标 / 结构不动），但填色换成 Win10 经典实底 ——
    按钮 #E1E1E1 实底 + #ADADAD 描边，悬停亮蓝描边 #0078D7，按下浅蓝底；
    输入框白底；卡片实色无半透明。经 ApplyMetroOverlay 按变体加载，
    SwapMetroVariant 深浅色切换时同位替换。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 应用底色：Win10 浅色纯白 -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFF2F2F2" />

    <!-- 按钮：Win10 经典（实底 / 灰描边 / 悬停蓝描边） -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFE5F1FB" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFCCE4F7" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFADADAD" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FFBFBFBF" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FF000000" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FF000000" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FF000000" />

    <!-- 强调按钮：经典 Win10 蓝（悬停 / 按下加深，非半透明） -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF0078D7" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF106EBE" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF005A9E" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />

    <!-- 通用控件填充：Win8/Win10 式实底（取代 WinUI 半透明层） -->
    <SolidColorBrush x:Key="ControlFillColorDefault" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="ControlFillColorSecondary" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ControlFillColorTertiary" Color="#FFCFCFCF" />
    <SolidColorBrush x:Key="ControlFillColorDisabled" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ControlFillColorInputActive" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ControlStrongFillColorDefault" Color="#FFE1E1E1" />

    <!-- 微妙填充（卡片 / 列表项悬停）：实色浅灰 -->
    <SolidColorBrush x:Key="SubtleFillColorSecondary" Color="#FFDADADA" />
    <SolidColorBrush x:Key="SubtleFillColorTertiary" Color="#FFCCCCCC" />

    <!-- 卡片：实色 -->
    <SolidColorBrush x:Key="CardBackgroundFillColorDefault" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondary" Color="#FFF2F2F2" />

    <!-- 描边：Win10 式硬边 -->
    <SolidColorBrush x:Key="ControlStrokeColorDefault" Color="#FFE6E6E6" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondary" Color="#FF707070" />
    <SolidColorBrush x:Key="ControlStrokeColorTertiary" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolid" Color="#FFEBEBEB" />

    <!-- 组合框：白底实色（展开态白底 + 蓝描边，Win10 式） -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#FF0078D7" />

    <!-- 复选框 / 开关底色 -->
    <SolidColorBrush x:Key="CheckBoxBackground" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#FF0078D7" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#FF106EBE" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillUncheckedPointerOver" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFE1E1E1" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FFD9D9D9" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#FFCCE4F7" />

    <!-- 焦点框：Win10 式黑（浅色模式） -->
    <SolidColorBrush x:Key="FocusStrokeColorOuter" Color="#FF000000" />

    <!-- v0.15.14：Win10 换骨层补充键（Win10Controls.xaml 模板引用） -->
    <SolidColorBrush x:Key="TextBoxBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="TextBoxBackgroundDisabled" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#FFADADAD" />
    <SolidColorBrush x:Key="TextBoxBorderBrushPointerOver" Color="#FF767676" />
    <SolidColorBrush x:Key="TextBoxBorderBrushFocused" Color="#FF0078D7" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FFADADAD" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#FF767676" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackground" Color="#FFCCE4F7" />
    <!-- v0.16.0：Win10 滚动条（12px 扁平方角拇指） -->
    <SolidColorBrush x:Key="ScrollBarThumbBackground" Color="#FFCDCDCD" />
    <SolidColorBrush x:Key="ScrollBarThumbHover" Color="#FFA6A6A6" />
    <SolidColorBrush x:Key="ScrollBarThumbPressed" Color="#FF606060" />
    <SolidColorBrush x:Key="DangerButtonBackground" Color="#FFE81123" />
    <SolidColorBrush x:Key="DangerButtonBackgroundPointerOver" Color="#FFF1707A" />
    <SolidColorBrush x:Key="DangerButtonBackgroundPressed" Color="#FFC50E1F" />
    <SolidColorBrush x:Key="DangerButtonForeground" Color="#FFFFFFFF" />
</ResourceDictionary>
